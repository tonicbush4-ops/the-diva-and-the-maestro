        items: [{ title: 'Playbill', url: 'https://dl.thehistorymakers.org/catalog/4b60bbcb40048ee3c40ec497e72ac208' }],
      },
      {
        date: 'March 31, 1941',
        cat: 'other',
        title: '“The Little Foxes” — return engagement',
