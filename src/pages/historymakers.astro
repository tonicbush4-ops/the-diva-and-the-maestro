  .hm-card-body h3 { font-size: 19px; line-height: 1.2; margin: 0; }
  .hm-card-credits { font-size: 14px; color: var(--ink-2); margin: 0; }
  .hm-card-notes { font-size: 13.5px; color: var(--muted); margin: 0 0 6px; flex: 1; }
  .hm-card-body .btn-row { margin: 2px 0 0; }
  .hm-card-body .btn { align-self: flex-start; padding: 9px 16px; font-size: 12.5px; }
  .footnote { margin-top: 16px; font-size: 13.5px; color: var(--muted); max-width: var(--measure); }

  .hm-pages { margin-top: 2px; }
  .hm-pages-toggle { background: none; border: none; padding: 0; font-family: var(--body); font-size: 12.5px; font-weight: 600; letter-spacing: .02em; color: var(--oxblood); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .hm-pages-toggle:hover { color: var(--ink); }
  .hm-viewer { margin-top: 12px; }
  .hm-viewer-stage { display: grid; grid-template-columns: 28px 1fr 28px; gap: 6px; align-items: center; }
  .hm-viewer-frame { position: relative; aspect-ratio: 3 / 4; background: var(--ink); overflow: hidden; }
  .hm-viewer-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: none; }
  .hm-viewer-frame img.current { display: block; }
  .hm-viewer-nav { width: 28px; height: 40px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font-family: var(--display); font-size: 19px; line-height: 1; cursor: pointer; padding: 0; }
  .hm-viewer-nav:hover { background: var(--ink); color: var(--paper); }
  .hm-viewer-nav[disabled] { opacity: .3; cursor: default; }
  .hm-viewer-nav[disabled]:hover { background: var(--paper); color: var(--ink); }
