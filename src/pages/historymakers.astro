const sheetMusic = [
  { title: 'Red Red Rose', credits: 'Words Alex Rogers, Music Will Marion Cook', notes: "As sung by Abbie Mitchell Cook in Williams and Walker's Bandanna Land. Pub. Shapiro Music Publisher, NY", href: 'https://dl.thehistorymakers.org/catalog/c235dfd8c41e772ba316f46da02fd69f' },
  { title: 'Bon Bon Buddy, The Chocolate Drop', credits: 'Words Alex Rogers, Music Will Marion Cook', notes: 'Introduced by Geo. W. Walker in Williams & Walker’s Bandanna Land. Pub. The Gotham-Attucks Music Co., NY', href: 'https://dl.thehistorymakers.org/catalog/0f222f3444ec9c4bbd88cde483adfabd' },
  { title: 'Good Evenin’ ("A Real Native Southern Negro Melody")', credits: 'Paul Laurence Dunbar and Will Marion Cook', notes: 'Music Supplement of the N.Y. American and Journal, Sunday, March 22, 1903, pages 5-8. Pub. by permission of Harry Von Tilzer Music Publishing Co.', href: 'https://dl.thehistorymakers.org/catalog/f172789a4dc37f369b80927908b6ffe7' },
  { title: 'Porgy and Bess (full score cover)', credits: 'Music George Gershwin', notes: 'Gershwin Publishing Corp., New York; Chappell & Co. Inc., sole selling agent', href: 'https://dl.thehistorymakers.org/catalog/25e81db6b4067a0273776c1e105d9ee0' },
  { title: 'Lovie Joe', credits: 'Words Will Marion Cook, Music Joe Jordan', notes: "Jardin de Paris, Ziegfeld Revue, Follies of 1910, staged by Julian Mitchell. Pub. Harry Von Tilzer Music Publishing Co.", href: 'https://dl.thehistorymakers.org/catalog/657b331a310bd35a333b5d710321e647' },
  { title: 'The Little Gypsy Maid / What Would You Be A-Doing / She Did-It All Herself (3 songs, one cover)', credits: 'Words Harry B. Smith and Cecil Mack, Music Will Marion Cook', notes: "From George W. Lederer's production of The Wild Rose. Sole selling agents Harry Von Tilzer Music Publishing Co.", href: 'https://dl.thehistorymakers.org/catalog/0119cf3b8d44392f2a454fcea74e2cbe' },
  { title: 'Handwritten manuscript page', credits: 'Lyrics by Sterling Brown, Music by Will M. Cook', notes: 'Marginal note reads "Sterling Br[own]... 1955"; also marked "Louisa V.N."', href: 'https://dl.thehistorymakers.org/catalog/5c351775a373a55530bbe5699d5328c4' },
  { title: 'Handwritten manuscript page (second copy)', credits: 'Lyrics by Sterling Brown, Music by Will M. Cook', notes: 'Same note as above; appears to be a duplicate scan', href: 'https://dl.thehistorymakers.org/catalog/31f4892364eb8744bb4ad3ddd136fece' },
  { title: 'Returned ("A Negro Ballad")', credits: 'Composer Will Marion Cook', notes: "As sung by Miss Abbie Mitchell at Mrs. Cornelius Vanderbilt's Newport Theatre Party. Music Supplement of the N.Y. American and Journal, Sunday, Sept. 21, 1902, pages 5-8", href: 'https://dl.thehistorymakers.org/catalog/7f8c128f723cc355e2a5b130afa5add5' },
  { title: "Whoop 'er Up (With a Whoop La La)", credits: 'Words Andrew B. Sterling, Music Will Marion Cook', notes: "Sung by Marie Cahill in Daniel V. Arthur's musical comedy Judy Forgot (opened Oct. 6, 1910). Pub. Harry Von Tilzer Music Publishing Co.", href: 'https://dl.thehistorymakers.org/catalog/0c5fdb14763eaa1b759110e551fe4387' },
  { title: 'Summer Time (arr. for Female Voices, S.S.A.)', credits: 'Music George Gershwin, Lyrics DuBose Heyward', notes: 'From Porgy and Bess. Price 20 cents. Gershwin Publishing Corp.', href: 'https://dl.thehistorymakers.org/catalog/fdea1f13d4a4ca19e60f7aa3144e4b36' },
  { title: 'Wid de Moon, Moon, Moon ("Negro Love-Song")', credits: 'Music Will Marion Cook, Words William Moore', notes: 'As sung by Marie Cahill. 60 cents. New York: G. Schirmer; Boston: The Boston Music Co.; London: Schott & Co.', href: 'https://dl.thehistorymakers.org/catalog/4ba9c4f9f83219aae21ae0efa0da829d' },
  { title: 'If the Sands of the Seas Were Pearls (Operatic Edition)', credits: 'Words James Weldon Johnson, Music Will Marion [Cook]', notes: 'Pub. Jerome H. Remick & Co., New York / Detroit', href: 'https://dl.thehistorymakers.org/catalog/32f176afb61d55f156c94fd012e2b6a5' },
  { title: 'Wid de Moon, Moon, Moon (second copy)', credits: 'Music Will Marion Cook, Words William Moore', notes: 'Same edition as above', href: 'https://dl.thehistorymakers.org/catalog/9df95be630e8ccdc8dde3df5e25a37ca' },
  { title: 'The Southerners ("The Unique Musical Romance")', credits: 'Libretto & Lyrics Richard Grant and Will Mercer, Music Will Marion Cook', notes: 'Geo. W. Lederer production (1904). Pub. John H. Cook Pub. Co.; distributed by The York Music Co., NY', href: 'https://dl.thehistorymakers.org/catalog/aea3d8638cc04bff91ef63cc5997613d' },
